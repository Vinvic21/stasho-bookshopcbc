# ─────────────────────────────────────────────────────────────────────────────
# Stasho backend settings. This file is private: it is git-ignored, never commit it.
# Restart the Flask server after editing it.
# ─────────────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string

# ── M-Pesa Daraja ────────────────────────────────────────────────────────────
# Paste your keys from https://developer.safaricom.co.ke (My Apps -> your app).
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# SANDBOX (testing): prompts go to Safaricom's simulator, NOT to real phones.
#   MPESA_BASE_URL=https://sandbox.safaricom.co.ke
#   MPESA_SHORTCODE=174379 and the public sandbox passkey below
# PRODUCTION (real prompts on real phones): needs Daraja "Go Live" approval.
#   MPESA_BASE_URL=https://api.safaricom.co.ke
#   MPESA_SHORTCODE=your Paybill / Till store number, MPESA_PASSKEY=the passkey Safaricom gave you
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Paybill: leave as is. Till number (Buy Goods): set TYPE to CustomerBuyGoodsOnline and
# MPESA_PARTY_B to your till number.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=

# Public HTTPS address Safaricom can call with the payment result (use an ngrok URL while testing,
# e.g. https://abc123.ngrok-free.app/api/mpesa/callback). Optional: payments are also confirmed by
# polling Safaricom, so checkout works without it.
MPESA_CALLBACK_URL=

# Leave empty = automatic: simulated payments while the consumer key/secret are blank, real Safaricom
# calls as soon as you fill them in. Set true to force simulated payments, false to force real calls.
MPESA_MOCK_MODE=
MPESA_MOCK_DELAY=5